# Copy to config.env and edit for machine-specific overrides. All optional.
# kokoromodel.sh sources this if present.

#KK_HOST=127.0.0.1
#KK_PORT=48490

# Backend is normally read from backend.txt (written by build.sh): cuda | cpu.
# The model-manager dock overrides to cpu when the model is moved to RAM.
#KK_BACKEND=cuda

# Default voice / speed / language / pitch for /speak when the request omits them.
# Voices: af_heart, af_bella, af_sarah, am_michael, am_adam, bf_emma, ... (GET /voices)
# KK_PITCH = semitones shifted after synthesis (duration-preserving, via rubberband).
# Current base voice identity: af_bella +4 semitones (bright, Miku-ish base for the
# Carla autotune/robotify rack to build on).
#KK_VOICE=af_bella
#KK_SPEED=1.05
#KK_LANG=en-us
#KK_PITCH=4

# Model overrides (defaults are models/kokoro-v1.0.onnx + models/voices-v1.0.bin)
#KK_MODEL=$HOME/programming/Models/kokoromodel/models/kokoro-v1.0.onnx
#KK_VOICES=$HOME/programming/Models/kokoromodel/models/voices-v1.0.bin

# Engine: onnx (default; kokoro-onnx, bounded VRAM) | torch (PyTorch kokoro in
# venv-torch — exposes per-phoneme durations for viseme lip-sync, served in the
# X-Kokoro-Align response header on /speak). Same weights => identical voice.
# Build venv-torch with `./build.sh torch`; reversible (unset/onnx + restart).
#KK_ENGINE=onnx
